# Modelo do .env para rodar o backend localmente: copie para .env (fora do git) e ajuste.
#   uv run --env-file .env uvicorn app.main:app --reload --port 8000 --root-path /api/ethos
# Os nomes são os mesmos de infra/apps/ethos/app.env + /etc/infra/smtp.env (um teste confere).
# Variável vazia conta como não definida.

# dev | prod. Com prod, o email de console é recusado e o APP_URL precisa ser https
APP_ENV=dev
# URL pública do front (o dev server do Vite em dev)
APP_URL=http://localhost:5174/ethos
# Caminho do arquivo SQLite; relativo à pasta de onde o servidor sobe
DATABASE_PATH=ethos-dev.db

# smtp | console. console só imprime o email no log e só vale com APP_ENV=dev
EMAIL_BACKEND=console
MAIL_FROM="ethos <no-reply@example.com>"
SUPPORT_EMAIL=suporte@example.com

# Credenciais SMTP, obrigatórias com EMAIL_BACKEND=smtp (em produção vêm do /etc/infra/smtp.env)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Teto global de envio de códigos (por hora não pode passar do por dia)
MAX_CODE_EMAILS_PER_HOUR=50
MAX_CODE_EMAILS_PER_DAY=200

# Limites das decisões de produto (sem a variável, vale o padrão do plano, igual a estes)
MAX_HABITS_PER_USER=10
MAX_MARKS_PER_DAY=999
MAX_NOTE_LENGTH=140
MAX_GUESTS_PER_HABIT=5
MAX_SHARED_HABITS_PER_USER=20
MAX_INVITES_PER_DAY=20
