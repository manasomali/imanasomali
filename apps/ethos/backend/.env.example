# Modelo do .env para rodar o backend localmente: copie para .env (fora do git) e ajuste.
#   uv run --env-file .env alembic upgrade head
#   uv run --env-file .env uvicorn app.main:app --reload --port 3001 --root-path /api/ethos
# Os nomes são os de infra/apps/ethos/app.env + /etc/infra/internal/ethos.env (um teste confere).
# Variável vazia conta como não definida.

# dev | prod. Com prod, o APP_URL precisa ser https (e o seed é recusado)
APP_ENV=dev
# URL pública do front, pela origem do nginx de dev (apps/imago/dev/)
APP_URL=http://localhost:8080/ethos
# Caminho do arquivo SQLite; relativo à pasta de onde o servidor sobe
DATABASE_PATH=ethos-dev.db

# API interna do imago (o backend do imago rodando na máquina, na porta de produção)
IMAGO_INTERNAL_URL=http://127.0.0.1:3003
# Token do ethos na API interna (em produção, /etc/infra/internal/ethos.env). O mesmo valor vai
# no IMAGO_APP_TOKENS do imago de dev (ethos:<token>). Só para desenvolver: nunca use em produção
INTERNAL_API_TOKEN=dev-only-ethos-token-not-a-secret-0000

# Limites das decisões de produto (sem a variável, vale o padrão do plano, igual a estes)
MAX_HABITS_PER_USER=10
MAX_MARKS_PER_DAY=999
MAX_NOTE_LENGTH=140
MAX_GUESTS_PER_HABIT=5
MAX_SHARED_HABITS_PER_USER=20
MAX_INVITES_PER_DAY=20
