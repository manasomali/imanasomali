# Modelo do .env para rodar o backend localmente: copie para .env (fora do git) e ajuste.
#   uv run --env-file .env alembic upgrade head
#   uv run --env-file .env uvicorn app.main:app --reload --port 3003 --root-path /api/imago
# Os nomes são os de infra/apps/imago/app.env + /etc/infra/smtp.env + IMAGO_APP_TOKENS
# (/etc/infra/internal/imago.env). Variável vazia conta como não definida.

# dev | prod. Com prod, o email de console é recusado e o APP_URL precisa ser https
APP_ENV=dev
# URL pública do front. Em dev, a do nginx de desenvolvimento (origem única de site, imago e
# aplicações); a origem dela é a única aceita no header Origin
APP_URL=http://localhost:8080/imago
# Caminho do arquivo SQLite; relativo à pasta de onde o servidor sobe
DATABASE_PATH=imago-dev.db

# Contato da tela de conta e destino do aviso de teto de envio
SUPPORT_EMAIL=suporte@example.com
# Remetente de todos os emails ("manasomali.com <...>" ou "<aplicação> <...>")
MAIL_FROM_ADDRESS=no-reply@example.com
# smtp | console. console só imprime o email no log e só vale com APP_ENV=dev
EMAIL_BACKEND=console

# Aplicações que usam o imago (nome=http://127.0.0.1:<porta>, separadas por vírgula), na ordem da
# tela de conta. Pode ficar vazia; cada uma precisa do seu token em IMAGO_APP_TOKENS
IMAGO_APPS=ethos=http://127.0.0.1:3001

# Teto de envio de email, um só para o imago e todas as aplicações, em janelas móveis de 24 h e
# 1 h. O fim de cada janela fica só para códigos e emails de conta (as notificações param antes)
MAX_EMAILS_PER_DAY=275
MAX_EMAILS_PER_HOUR=60
MAIL_RESERVED_FOR_CODES_PER_DAY=60
MAIL_RESERVED_FOR_CODES_PER_HOUR=15

# Credenciais SMTP, obrigatórias com EMAIL_BACKEND=smtp (em produção vêm do /etc/infra/smtp.env)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Token da API interna de cada aplicação (nome:token, base64url com 32 a 512 caracteres). Em
# produção vem do /etc/infra/internal/imago.env, gerado na VM. Em dev, o mesmo valor vai no
# INTERNAL_API_TOKEN do .env da aplicação. Este é só de desenvolvimento
IMAGO_APP_TOKENS=ethos:dev-only-ethos-token-not-a-secret-0000
