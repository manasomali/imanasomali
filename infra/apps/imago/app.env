# Config não secreta do imago, instalada em /etc/infra/apps/imago.env (EnvironmentFile= das units).
# Segredos não entram aqui: as credenciais SMTP ficam em /etc/infra/smtp.env (secrets do GitHub) e os
# tokens da API interna em /etc/infra/internal/imago.env (IMAGO_APP_TOKENS, gerado na VM pelo provision).
# Formato do systemd: valor com espaço ou caractere especial vai entre aspas duplas.

# Ambiente: prod aqui; dev só na máquina de quem desenvolve (libera o email de console e o seed)
APP_ENV=prod
# A origem dele (https://manasomali.com) é a única aceita no Origin das requests que escrevem
APP_URL=https://manasomali.com/imago
DATABASE_PATH=/var/lib/sqlite/imago/app.db

# Email: só o imago fala com o SMTP (credenciais do smtp.env); console só em dev
EMAIL_BACKEND=smtp
MAIL_FROM_ADDRESS=no-reply@manasomali.com
SUPPORT_EMAIL=suporte@manasomali.com

# Aplicações que usam a conta: <nome>=http://127.0.0.1:<PORT do infra/apps/<nome>/app.conf>,
# separadas por vírgula. Toda pasta de infra/apps/ (menos o imago) entra aqui, com os textos dela
# no front do imago (.github/scripts/check-imago-apps.sh confere)
IMAGO_APPS=ethos=http://127.0.0.1:3001

# Teto de envio compartilhado por todas as aplicações, em janelas móveis. A cota da Brevo é 300 por
# dia: 275 + até 24 avisos de teto ao SUPPORT_EMAIL. O fim de cada janela fica só para códigos e
# emails de conta (notificações param em 215 por dia e 45 por hora)
MAX_EMAILS_PER_DAY=275
MAX_EMAILS_PER_HOUR=60
MAIL_RESERVED_FOR_CODES_PER_DAY=60
MAIL_RESERVED_FOR_CODES_PER_HOUR=15
