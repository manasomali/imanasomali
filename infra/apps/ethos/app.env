# Config não secreta do ethos, instalada em /etc/infra/apps/ethos.env (EnvironmentFile= da unit).
# O ethos não fala com o SMTP: manda os emails pelo imago (POST /internal/mail), com o token de
# /etc/infra/internal/ethos.env (INTERNAL_API_TOKEN), gerado na VM pelo provision.
# Formato do systemd: valor com espaço ou caractere especial vai entre aspas duplas.

# Ambiente: prod aqui; dev só na máquina de quem desenvolve
APP_ENV=prod
APP_URL=https://manasomali.com/ethos
DATABASE_PATH=/var/lib/sqlite/ethos/app.db
# API interna do imago (a conta única), direto, sem o nginx
IMAGO_INTERNAL_URL=http://127.0.0.1:3003

# Limites das decisões de produto
MAX_HABITS_PER_USER=10
MAX_MARKS_PER_DAY=999
MAX_NOTE_LENGTH=140
MAX_GUESTS_PER_HABIT=5
MAX_SHARED_HABITS_PER_USER=20
MAX_INVITES_PER_DAY=20
