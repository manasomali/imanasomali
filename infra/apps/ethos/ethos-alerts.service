# Alertas do ethos, disparado pelo ethos-alerts.timer de hora em hora. A limpeza das contas, sessões
# e códigos é do imago (imago-cleanup.timer).

[Unit]
Description=ethos: alertas
ConditionPathExists=/opt/apps/ethos/.venv/bin/python
# Grava uma linha de erro no journald (journalctl -t infra -p err)
OnFailure=infra-unit-failed@%n.service

[Service]
Type=oneshot
User=app-ethos
Group=app-ethos
WorkingDirectory=/opt/apps/ethos
# Os alertas saem pelo imago (POST /internal/mail), com o token do ethos
EnvironmentFile=/etc/infra/internal/ethos.env
EnvironmentFile=/etc/infra/apps/ethos.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/apps/ethos/.venv/bin/python -m app.cli run-alerts

MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sqlite/ethos
