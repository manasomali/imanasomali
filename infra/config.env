# Parâmetros fixos da infra. Lido pelo provision.sh e copiado para /etc/infra/config.env na VM.

# Usuário que o CI usa no SSH (secret REMOTE_USER). Dono de /opt/apps/<nome> e /var/www/<nome>.
# O ubuntu das imagens da OCI tem sudo total sem senha (ver PLANO.md).
DEPLOY_USER=ubuntu

# Domínio usado no smoke test (https://<domínio>/ resolvido para 127.0.0.1)
SITE_DOMAIN=manasomali.com

# Litestream: tarball oficial de github.com/benbjohnson/litestream/releases (linux-x86_64)
LITESTREAM_VERSION=0.5.17
LITESTREAM_SHA256=cfb371176d164437ae869f8351cfde49bd1804ae71c61923f75c9cba9c9c006d

# uv: tarball oficial de github.com/astral-sh/uv/releases (x86_64-unknown-linux-gnu).
# Instala o Python das aplicações (PYTHON_VERSION em infra/apps/<nome>/app.conf), já compilado.
UV_VERSION=0.13.5
UV_SHA256=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
# Fora de /home: as units das aplicações rodam com ProtectHome=true
UV_PYTHON_INSTALL_DIR=/opt/uv/python

# Frequência de envio das mudanças ao Object Storage (= perda máxima de dados).
# O Always Free inclui ~50 mil requisições/mês: um banco escrevendo sem parar com 1m gasta ~45 mil.
LITESTREAM_SYNC_INTERVAL=1m
